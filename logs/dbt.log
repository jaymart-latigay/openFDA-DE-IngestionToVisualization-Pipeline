[0m16:14:55.561016 [debug] [Thread-1 (]: On model.fda_project.stg_drugs: /* {"app": "dbt", "dbt_version": "1.7.19", "profile_name": "fda_project", "target_name": "dev", "node_id": "model.fda_project.stg_drugs"} */

  create view "airflow"."public"."stg_drugs__dbt_tmp"
    
    
  as (
    WITH raw_drugs AS (
    SELECT * FROM "airflow"."public"."drugs"
)

SELECT
    drug_id,
    safetyreportid,
    -- Strips non-alphanumeric characters from the start, then trims and capitalizes
    UPPER(TRIM(REGEXP_REPLACE(medicinal_product, '^[^a-zA-Z0-9]+', ''))) AS medicinal_product,
    
    CASE 
        WHEN drug_characterization = 1 THEN 'Suspect'
        WHEN drug_characterization = 2 THEN 'Concomitant'
        WHEN drug_characterization = 3 THEN 'Interacting'
        ELSE 'Unspecified'
    END AS drug_characterization

FROM raw_drugs
